# Cursor SDK
CURSOR_API_KEY=cursor_...
CURSOR_MODEL=composer-2.5

# Local riskon-agent checkout (host path mounted into Docker)
RISKON_AGENT_HOST_PATH=/Users/aliamjid/.cursor/riskon-agent
RISKON_AGENT_PATH=/workspace/riskon-agent

# API
PORT=3000
DATABASE_URL=postgres://riskon:riskon@localhost:5432/riskon
NODE_ENV=development

# MinIO / S3-compatible artifact storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=riskon-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1

# Web (Vite dev)
VITE_API_URL=http://localhost:3000
