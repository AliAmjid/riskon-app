# Cursor SDK
CURSOR_API_KEY=cursor_...
CURSOR_MODEL=composer-2.5

# Local riskon-agent checkout (host path mounted into Docker)
RISKON_AGENT_HOST_PATH=/Users/aliamjid/.cursor/riskon-agent
RISKON_AGENT_PATH=/workspace/riskon-agent

# API
PORT=3000
DATABASE_URL=postgres://riskon:riskon@localhost:5432/riskon
NODE_ENV=development

# Public origin of this API (cloud agents download datasets and call MCP here).
# Local: leave unset, or set to an ngrok URL (`npm run tunnel`).
# Production: https://your-api-host
# PUBLIC_BASE_URL=

# Web (Vite). In local `npm run dev` this is unused — Vite proxies /api.
# On Netlify this is baked in at build time: the public API origin, no trailing slash.
VITE_API_URL=http://localhost:3000
