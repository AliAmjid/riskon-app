# Production env for docker-compose.prod.yml on the droplet.
# Copy to /var/www/riskon/.env — never commit it.

DOMAIN=propertydog.mst.co.cz
ACME_EMAIL=admin@mst.co.cz
PUBLIC_BASE_URL=https://propertydog.mst.co.cz

POSTGRES_USER=riskon
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=riskon

CURSOR_API_KEY=cursor_...
CURSOR_MODEL=composer-2.5
AGENT_REPOSITORY_URL=https://github.com/AliAmjid/riskon
AGENT_REPOSITORY_REF=main

# First boot needs this: there are no migrations yet.
TYPEORM_SYNCHRONIZE=true
