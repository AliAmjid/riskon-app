{
  "name": "riskon-app",
  "version": "0.1.0",
  "private": true,
  "description": "Riskon web app — trigger OR agent runs via Cursor SDK",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run db:up && npm run build -w @riskon/shared",
    "dev": "concurrently -n shared,api,web -c gray,magenta,cyan -k \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev -w @riskon/shared",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "db:up": "docker compose up -d --wait postgres",
    "build": "npm run build -w @riskon/shared && npm run build -w api && npm run build -w web",
    "tunnel": "node scripts/tunnel.mjs",
    "smoke": "node scripts/smoke.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pg": "^8.23.0"
  }
}
